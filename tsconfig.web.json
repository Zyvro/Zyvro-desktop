{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "next/link": [
        "./src/renderer/shims/next-link.tsx"
      ],
      "next/navigation": [
        "./src/renderer/shims/next-navigation.ts"
      ],
      "next/image": [
        "./src/renderer/shims/next-image.tsx"
      ],
      "@/*": [
        "../Zyvro-frontend/src/*"
      ],
      // Le pendant, au niveau des types, du `dedupe` de electron.vite.config.ts.
      // Deux copies de @types/react, même version, donnent deux `ReactNode`
      // que TypeScript tient pour distincts : tout composant venant d'un
      // paquet qui résout la copie du front devenait « not a valid JSX element
      // type ». 123 erreurs avant ces quatre lignes, aucune après.
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ],
      "~/*": [
        "./src/renderer/*"
      ]
    }
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/preload/**/*.ts",
    "../Zyvro-frontend/src/**/*.ts",
    "../Zyvro-frontend/src/**/*.tsx"
  ]
}
